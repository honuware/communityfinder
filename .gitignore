# See http://help.github.com/ignore-files/ for more about ignoring files.

# Build output
out/
win_build/
/build
/server/communityfinder_server/build
/server/communityfinder_server/test/build
/server/communityfinder_server/dist/*.gz
/out-tsc
/bazel-out

# CMake / Conan generated (ConanLibImports.cmake is generated by conanfile init())
ConanLibImports.cmake
CMakeUserPresets.json
conan.cmake
conan.lock
conanbuildinfo.cmake
conanbuildinfo.txt
conaninfo.txt
graph_info.json

# UI (Angular) build + deps
/ui/dist
/ui/.angular
/ui/node_modules

# NOTE: package-lock.json is intentionally NOT ignored — the CI ui job uses
# `npm ci`, which requires a committed lock file.

# Dev database data
/database_server/data

# npm / node logs
npm-debug.log
yarn-error.log

# profiling
chrome-profiler-events*.json
speed-measure-plugin*.json

# IDEs and editors
/.idea
.project
.cache
.clangd
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vs/
/.vscode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.sass-cache
/connect.lock
/coverage
testem.log
/typings
/tmp

# System files
.DS_Store
Thumbs.db

# Claude
.claude/settings.local.json
